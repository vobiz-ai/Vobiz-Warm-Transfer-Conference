# ─── Gemini Live ──────────────────────────────────────────────────────────
# The AI brain for both flows. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Run `python ../vobiz-gemini-live/models.py` to see what this key can use —
# the list changes, and an unsupported name fails with a bare WebSocket close
# 1008 that says nothing useful. Known good here:
#   gemini-3.1-flash-live-preview          (default, best tool use)
#   gemini-2.5-flash-native-audio-latest
# Known bad on this key: gemini-live-2.5-flash-preview
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Two agents talk in this system, so give them different voices — otherwise the
# briefing and the customer agent are indistinguishable on a recording.
# Aoede Puck Charon Kore Fenrir Leda Orus Zephyr
GEMINI_VOICE=Aoede
GEMINI_BRIEF_VOICE=Charon

# Pin this on an Indian line. Left on auto, background noise gets transcribed as
# whatever language fits best and the model answers in it.
GEMINI_LANGUAGE=en-IN

# ─── Vobiz ────────────────────────────────────────────────────────────────
# Accounts are not interchangeable: a `from` number the account does not own is
# rejected outright, so these two must belong together.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
FROM_NUMBER=+91XXXXXXXXXX

# Demo destinations.
CUSTOMER_NUMBER=+91XXXXXXXXXX
AGENT_NUMBER=+91XXXXXXXXXX
# A registered SIP endpoint, for the WebRTC half of the demo. Must be registered
# at the moment of the call. No port and no ;transport= — an explicit port makes
# the dial silently no-op with no INVITE and no error.
AGENT_SIP=sip:agent@registrar.vobiz.ai

# ─── Flow behaviour ───────────────────────────────────────────────────────
# duplex  the Stream REST API media bug: real-time, Gemini's own voice.
# tap     <Stream audioTrack="both"> + per-member REST Speak. Proven fallback,
#         but half-duplex and in Vobiz's TTS voice rather than Gemini's.
AI_MODE=duplex

# Format for the REST-attached media bug on a leg inside a conference.
CONF_CONTENT_TYPE=audio/x-mulaw;rate=8000
CONF_OUT_TYPE=audio/x-mulaw
CONF_OUT_RATE=8000

# How long the human's phone rings before the customer is told nobody is free.
RING_TIMEOUT=25
# Pause between ConferenceEnter and attaching the media bug. Attach too early
# and the stream hears nothing, because the leg has not settled in the room.
SETTLE_DELAY=2.0

# Detach the AI once the human is bridged, instead of leaving it listening.
AI_DROP_AFTER_BRIDGE=false
# Deliverable 2: re-attach the AI after the Transfer tears its stream down.
REATTACH_AI_AFTER_TRANSFER=true

# End-of-turn tuning. Empty = API default, which is fine on a clean line.
VAD_SILENCE_MS=
PLAY_CHUNK_MS=20

# ─── Server ───────────────────────────────────────────────────────────────
# 8100 because 8000 is usually held by ../1-testing.
HTTP_PORT=8100
# Set on a box with a public IP. Empty => ngrok starts automatically.
PUBLIC_URL=
NGROK_DOMAIN=
NGROK_AUTH_TOKEN=
LOG_LEVEL=INFO
